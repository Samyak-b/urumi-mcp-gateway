# Copy to .env and fill in. .env is git-ignored.
# Passwords and tokens are NOT set here: `make secrets` generates them.

# Chat agent: any OpenAI-compatible /chat/completions endpoint that supports tool calling.
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=model-name
LLM_API_KEY=

# First dashboard admin (the password is generated; see `make creds`).
ADMIN_EMAIL=admin@example.com
